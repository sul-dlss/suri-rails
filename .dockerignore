# Ignore git directory.
/.git/
/.gitignore

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all default key files.
/config/master.key
/config/credentials/*.key

# Ignore all logfiles and tempfiles, but keep the directories.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
/tmp/pids/*
!/tmp/pids/.keep

# Ignore CI service files.
/.circleci
/.github

# Ignore development files
/.byebug_history
/.claude
/compose.yaml

# Ignore tests and test output
/spec
/coverage

# Ignore Docker-related files
/.dockerignore
/Dockerfile*
